#!/usr/bin/env bash
# Mosaic launcher.
#
# Mosaic is a general-purpose agent built on OpenCode's engine. This script is
# what makes it a separate program rather than a themed OpenCode: OpenCode
# derives every path it uses from the XDG base directories, so pointing those
# at ~/.mosaic gives Mosaic its own config, sessions, credentials, and cache. A
# user can run both, and neither sees the other's state.
set -euo pipefail

MOSAIC_HOME="${MOSAIC_HOME:-$HOME/.mosaic}"
export MOSAIC_HOME

# Resolve this script's directory through symlinks so the install stays
# relocatable and a PATH shim still finds the runtime next to it.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"

export XDG_DATA_HOME="$MOSAIC_HOME/data"
export XDG_CONFIG_HOME="$MOSAIC_HOME/config"
export XDG_CACHE_HOME="$MOSAIC_HOME/cache"
export XDG_STATE_HOME="$MOSAIC_HOME/state"
mkdir -p "$XDG_DATA_HOME" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"

# Mosaic's config is generated rather than shipped, because it has to carry
# absolute paths to the plugin and prompt files inside this install.
export OPENCODE_CONFIG="${MOSAIC_CONFIG:-$MOSAIC_HOME/mosaic.json}"

case "${1:-}" in
  plugins)
    shift
    MOSAIC_ROOT="$ROOT" exec bun run "$ROOT/src/plugins.ts" "$@"
    ;;
esac

MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/plugins.ts" sync
MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/config.ts" > "$OPENCODE_CONFIG"

# The TUI reads its own config from a fixed path rather than $OPENCODE_CONFIG,
# and only it will load a plugin's `tui` half.
tui_dir="$XDG_CONFIG_HOME/opencode"
mkdir -p "$tui_dir"
# Written via a temporary file: the generator reads the current one to preserve
# the user's settings, so it cannot be the target of its own redirect.
MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/config.ts" --tui "$tui_dir/tui.json" > "$tui_dir/tui.json.new"
mv "$tui_dir/tui.json.new" "$tui_dir/tui.json"

# Keep Swarm's agents in step with the vendored checkout. Cheap, and it repairs
# a half-deleted install without a separate command.
MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/swarm.ts" 2>/dev/null || true

# The engine updates itself through Mosaic's release, not OpenCode's.
export OPENCODE_DISABLE_AUTOUPDATE=1

# Project config is discovered by *filename* — the engine walks up from the
# working directory looking for opencode.json and .opencode/. That is a
# different mechanism from the XDG paths above, so an OpenCode user with a
# config anywhere on the path to their work (a ~/opencode.json is enough) had
# its providers and models appear inside Mosaic. Mosaic reads its own
# per-project config instead; see loadProjectConfig in src/config.ts.
export OPENCODE_DISABLE_PROJECT_CONFIG=1

engine="$ROOT/node_modules/.bin/opencode"
if [ ! -x "$engine" ]; then
  echo "mosaic: engine not installed at $engine" >&2
  echo "Run: bun install --cwd \"$ROOT\"" >&2
  exit 1
fi

export MOSAIC_VERSION
MOSAIC_VERSION="$(bun --print "require('$ROOT/package.json').version" 2>/dev/null || echo "unknown")"

case "${1:-}" in
  setup)
    shift
    MOSAIC_ROOT="$ROOT" exec bun run "$ROOT/src/setup/index.ts" --force "$@"
    ;;
  tasks)
    # Standalone scheduled tasks. Also the entry point the OS scheduler calls,
    # so it must work with no terminal and without the first-launch prompt
    # below ever running.
    shift
    MOSAIC_ROOT="$ROOT" exec bun run "$ROOT/src/tasks.ts" "$@"
    ;;
  --version | -v)
    # Report Mosaic's version, not the engine's — but name the engine, because
    # the answer to "what am I running" has to include it.
    echo "mosaic $MOSAIC_VERSION (opencode $("$engine" --version 2>/dev/null | tail -1))"
    exit 0
    ;;
  upgrade | uninstall)
    # These would manage an OpenCode install that Mosaic did not create.
    echo "mosaic: '$1' belongs to the engine and would act on an OpenCode install." >&2
    echo "Update Mosaic by reinstalling:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/morriszdweck/mosaic/main/install.sh | bash" >&2
    exit 1
    ;;
esac

# First launch: offer a model before dropping someone into a TUI that cannot
# answer them. Only on a terminal — a piped or scripted run must never block
# waiting for input that will not come.
if [ -t 0 ] && [ -t 1 ]; then
  MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/setup/index.ts" || true
  # Setup writes config.json, so the generated config has to be rebuilt.
  MOSAIC_ROOT="$ROOT" bun run "$ROOT/src/config.ts" > "$OPENCODE_CONFIG"
fi

exec "$engine" "$@"
